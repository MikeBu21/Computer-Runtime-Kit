[Unit]
Description=piminer Fehlerberichte → Telegram (stiller Hintergrunddienst)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/piminer/minersteuerung/scripts/error_log_pipeline/pi
Environment=ERROR_LOG_PIPELINE_CONFIG=/home/piminer/minersteuerung/scripts/error_log_pipeline/pi/config.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/piminer/minersteuerung/scripts/error_log_pipeline/pi/send_telegram.py --daemon
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
