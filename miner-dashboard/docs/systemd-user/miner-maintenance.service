[Unit]
Description=Miner Steuerung Wartungs-Watchdog
After=network-online.target miner-boot-repair.service
Wants=network-online.target miner-boot-repair.service

[Service]
Type=simple
WorkingDirectory=/home/piminer/minersteuerung/miner-dashboard/backend
Environment=MINER_RAM_CACHE=1
Environment=MINER_RAM_ROOT=/dev/shm/minersteuerung
Environment=MINER_RAM_FLUSH_SEC=3600
Environment=MINER_LOG_DIR=/dev/shm/minersteuerung/logs
Environment=MINER_ROOT=/home/piminer/minersteuerung
Environment=MAINTENANCE_CHECK_INTERVAL_SEC=120
ExecStartPre=/home/piminer/minersteuerung/miner-dashboard/boot_repair_after_powerloss.sh
ExecStart=/home/piminer/minersteuerung/venv/bin/python /home/piminer/minersteuerung/miner-dashboard/backend/maintenance_watchdog.py
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
