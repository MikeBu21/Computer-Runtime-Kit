[Unit]
Description=Collect 14-day piminer control errors into the outbox (manual)

[Service]
Type=oneshot
WorkingDirectory=/home/piminer/minersteuerung/scripts/error_log_pipeline/pi
Environment=ERROR_LOG_PIPELINE_CONFIG=/home/piminer/minersteuerung/scripts/error_log_pipeline/pi/config.json
ExecStart=/usr/bin/python3 /home/piminer/minersteuerung/scripts/error_log_pipeline/pi/collect_errors.py
