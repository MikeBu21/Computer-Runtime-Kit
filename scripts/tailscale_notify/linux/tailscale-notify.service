[Unit]
Description=Tailscale change → Telegram notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/minersteuerung/scripts/tailscale_notify/linux
Environment=TAILSCALE_NOTIFY_CONFIG=%h/minersteuerung/scripts/tailscale_notify/linux/config.json
Environment=TAILSCALE_NOTIFY_STATE=%h/minersteuerung/scripts/tailscale_notify/state/state.json
ExecStart=/usr/bin/python3 %h/minersteuerung/scripts/tailscale_notify/linux/tailscale_notify.py
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
